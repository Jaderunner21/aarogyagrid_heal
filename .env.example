# AarogyaGrid: environment variables. Copy this file to .env.local and fill it in; .env.local is never committed.
# Paste each value right after the "=" with no quotes and no spaces.

# Supabase > Project Settings > API > Project URL   (looks like https://abcdefghijklmnop.supabase.co)
NEXT_PUBLIC_SUPABASE_URL=

# Supabase > Project Settings > API > Project API keys > "anon" "public"
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase > Project Settings > API > Project API keys > "service_role" "secret"   (server only, keep private)
SUPABASE_SERVICE_ROLE_KEY=

# Supabase > Connect (top bar) > Connection string > "Session pooler". Replace [YOUR-PASSWORD] with your database password.
# Used only by the setup scripts.
SUPABASE_DB_URL=

# Supabase > Account (avatar, bottom-left) > Access Tokens > Generate new token. Used only to generate DB types.
SUPABASE_ACCESS_TOKEN=

# Google AI Studio (aistudio.google.com) > Get API key > Create API key   (server only)
GEMINI_API_KEY=

# Google AI Studio > model picker: the current "Flash" model id, e.g. gemini-3.7-flash
GEMINI_MODEL=gemini-3.7-flash

# Any long random string. Vercel cron sends it as a Bearer token.
CRON_SECRET=

# Password for all demo accounts (used by `npm run demo-users` and the demo sign-in panel).
DEMO_PASSWORD=
